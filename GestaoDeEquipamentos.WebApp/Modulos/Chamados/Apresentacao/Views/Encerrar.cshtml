@model EncerrarChamadoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Encerrar Chamado";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Encerrar" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden">

        <div class="alert alert-warning mt-4" role="alert">
            <strong>Encerrar chamado</strong><br>
            Você deseja encerrar o chamado "<strong>@Model.Titulo</strong>" do equipamento
            <strong>@Model.NomeEquipamento</strong>?<br>
            Data de Abertura: <strong>@Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")</strong>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-success" type="submit">
                <i class="bi bi-check-circle"></i>
                Confirmar encerramento
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>
</div>
