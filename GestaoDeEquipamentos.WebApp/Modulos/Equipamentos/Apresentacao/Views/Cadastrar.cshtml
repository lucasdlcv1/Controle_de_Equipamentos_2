@using GestaoDeEquipamentos.WebApp.Modulos.Equipamentos.Apresentacao

@model CadastrarEquipamentoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Equipamento";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Cadastrar" method="post">
        <div>
            <label class="form-label" asp-for="Nome"></label>
            <input class="form-control" asp-for="Nome" type="text">
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>

        <div>
            <label class="form-label" asp-for="Preco">Preço de Aquisição</label>
            <input class="form-control" asp-for="Preco" type="text">
            <span class="text-danger" asp-validation-for="Preco"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="FabricanteId">Fabricante</label>
            <select class="form-select" asp-for="FabricanteId">
                @foreach (FabricanteEquipamentoViewModel Fabricante in Model.Fabricante)
                {
                    <option value="@Fabricante.Id">@Fabricante.Nome</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label" asp-for="DataFabricacao">Data de Fabricação</label>
            <input class="form-control" asp-for="DataFabricacao" type="date">
            <span class="text-danger" asp-validation-for="DataFabricacao"></span>
        </div>


        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check"></i>
                Cadastrar
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>
</div>